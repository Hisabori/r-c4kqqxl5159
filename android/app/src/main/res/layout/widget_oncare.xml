<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_title" android:textSize="12sp" android:textStyle="bold" android:textColor="#3875EF"/>
<TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_date" android:textSize="14sp" android:textColor="#71737C" android:layout_marginTop="3dp"/>
<TextView android:id="@+id/widget_records" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_records" android:textSize="19sp" android:textStyle="bold" android:textColor="#17181C" android:layout_marginTop="12dp"/>
<TextView android:id="@+id/widget_routines" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_routines" android:textSize="14sp" android:textColor="#71737C" android:layout_marginTop="3dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="44dp" android:orientation="horizontal" android:layout_marginTop="6dp"><TextView android:id="@+id/widget_exercise" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/widget_button" android:text="@string/widget_exercise" android:textSize="14sp" android:textStyle="bold" android:textColor="#3875EF" android:contentDescription="@string/quick_exercise" android:layout_margin="3dp" android:padding="6dp"/><TextView android:id="@+id/widget_sleep" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/widget_button" android:text="@string/widget_sleep" android:textSize="14sp" android:textStyle="bold" android:textColor="#3875EF" android:contentDescription="@string/quick_sleep" android:layout_margin="3dp" android:padding="6dp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="44dp" android:orientation="horizontal"><TextView android:id="@+id/widget_mood" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/widget_button" android:text="@string/widget_mood" android:textSize="14sp" android:textStyle="bold" android:textColor="#3875EF" android:contentDescription="@string/quick_mood" android:layout_margin="3dp" android:padding="6dp"/><TextView android:id="@+id/widget_connect" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/widget_button" android:text="@string/widget_connect" android:textSize="14sp" android:textStyle="bold" android:textColor="#3875EF" android:contentDescription="@string/quick_connect" android:layout_margin="3dp" android:padding="6dp"/></LinearLayout>
</LinearLayout>